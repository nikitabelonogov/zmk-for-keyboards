#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Space, but with Ctrl held it also toggles the RU layer; Ctrl passes
        // through, so macOS still sees Ctrl+Space and switches the input source
        space_lang: space_language {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&lang_tog>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    macros {
        // Companion of space_lang: send the Space tap and flip the RU layer
        lang_tog: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp SPACE>, <&tog 4>;
        };

    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        // Layout-independent symbols: when RU mode is on, lower is overlaid
        // with macros that temporarily switch to ABC
        ru_lower_layer {
            if-layers = <1 4>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "en";
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                 &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB           &kp Q   &kp W   &kp E     &kp R     &kp T                                  &kp Y   &kp U     &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_CONTROL  &kp A   &kp S   &kp D     &kp F     &kp G                                  &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C     &kp V     &kp B   &kp C_MUTE    &rgb_ug RGB_TOG  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                  &kp LGUI  &kp LALT  &mo 1   &space_lang   &kp RET          &mo 2   &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower {
            display-name = "en low";
            bindings = <
&kp F12  &kp F1          &kp F2        &kp F3          &kp F4           &kp F5                         &kp F6     &kp F7      &kp F8        &kp F9                &kp F10                &kp F11
&trans   &trans          &trans        &trans          &trans           &trans                         &trans     &trans      &trans        &trans                &trans                 &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH        &kp DOLLAR       &kp PERCENT                    &kp CARET  &kp AMPS    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE
&trans  &kp GRAVE        &kp BACKSLASH &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp EQUAL    &trans    &trans  &kp PIPE   &kp MINUS   &kp PLUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
                                       &trans          &trans           &trans       &trans    &trans  &trans     &kp DELETE  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise {
            display-name = "up";
            bindings = <
&trans  &trans                    &trans    &trans                     &trans  &trans                    &trans  &trans                    &trans                     &trans          &trans           &trans
&trans  &kp LS(LG(LEFT_BRACKET))  &trans     &kp LS(LG(RIGHT_BRACKET))  &trans   &trans                    &trans  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &trans          &trans           &trans
&trans  &kp HOME                  &kp PG_DN  &kp PG_UP                  &kp END  &trans                    &trans  &kp LEFT_ARROW            &kp DOWN_ARROW             &kp UP_ARROW    &kp RIGHT_ARROW  &trans
&trans  &trans                    &trans    &trans                     &trans  &trans  &trans    &trans  &trans  &kp LC(LEFT)              &kp LC(RIGHT)              &trans          &trans           &trans
                                            &trans                     &trans  &trans  &trans    &trans  &trans  &kp DELETE                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system {
            display-name = "system";
            bindings = <
&bt BT_CLR                       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                       &trans  &trans                &trans                &trans        &trans        &trans
&ext_power EP_TOG                &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans                             &trans  &kp C_PREVIOUS        &kp C_PLAY_PAUSE      &kp C_NEXT    &trans        &trans
&rgb_ug RGB_COLOR_HSB(175,0,10)  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF                    &trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOL_DN  &kp C_VOL_UP  &trans
&trans                           &trans           &trans           &trans           &trans           &trans           &trans    &trans  &trans  &trans                &trans                &trans        &trans        &trans
                                                                   &trans           &trans           &trans           &trans    &trans  &trans  &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        russian {
            display-name = "ru";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_ru {
            display-name = "ru low";
            bindings = <
&trans  &trans         &trans             &trans              &trans               &trans                              &trans         &trans        &trans            &trans                &trans                 &trans
&trans  &trans         &trans             &trans              &trans               &trans                              &trans         &trans        &trans            &trans                &trans                 &trans
&trans  &trans          &kp LA(N2)         &kp LA(N3)          &kp LA(N4)           &kp LA(N5)                          &kp LA(N6)     &kp LA(N7)    &kp LA(N8)        &trans                &trans                 &kp LA(M)
&trans  &kp LA(LS(N0))  &trans             &kp LA(N9)          &kp LA(N0)           &trans           &trans    &trans   &kp LA(LS(N1)) &trans        &trans            &kp LS(GRAVE)         &kp GRAVE              &trans
                                          &trans              &trans               &trans           &trans    &trans   &trans         &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
